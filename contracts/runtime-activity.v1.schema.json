{
  "$comment": "Structural activity envelope only. Use SDK validators for lifetime and complete byte/depth/item bounds; verify detached signatures against independent trust. Current runtime bindings, time, deadlines and authority remain unchecked.",
  "$defs": {
    "ArtifactHandle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactHandle",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "workflow",
            "connector",
            "model",
            "agent",
            "evaluation",
            "policy",
            "knowledge",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "dependency": {
              "properties": {
                "kind": {
                  "const": "connector"
                }
              }
            },
            "kind": {
              "const": "connector_read"
            },
            "operation": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "dependency": {
              "properties": {
                "kind": {
                  "const": "model"
                }
              }
            },
            "kind": {
              "const": "model"
            },
            "operation": {
              "type": "null"
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "attempt_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "delivery_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "dependency": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "deployment_revision_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Deployment Revision Id",
      "type": "string"
    },
    "environment_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Environment Id",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Execution Id",
      "type": "string"
    },
    "expires_at_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Expires At Ms",
      "type": "integer"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "input": {
      "$ref": "#/$defs/ArtifactHandle"
    },
    "installation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Installation Id",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Instance Id",
      "type": "string"
    },
    "issued_at_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Issued At Ms",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "connector_read",
        "model"
      ],
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Operation"
    },
    "package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "pool_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Pool Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "recovery_epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Recovery Epoch",
      "type": "integer"
    },
    "replay_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "const": "lotuspond.runtime-activity.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "step_instance_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Step Instance Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "installation_id",
    "recovery_epoch",
    "workspace_id",
    "project_id",
    "environment_id",
    "execution_id",
    "step_instance_id",
    "attempt_id",
    "deployment_revision_id",
    "package_sha256",
    "plan_sha256",
    "configuration_sha256",
    "input",
    "kind",
    "dependency",
    "operation",
    "pool_id",
    "instance_id",
    "generation",
    "delivery_id",
    "replay_id",
    "issued_at_ms",
    "expires_at_ms"
  ],
  "title": "ActivityEnvelope",
  "type": "object"
}
