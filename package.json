{
  "name": "lotuspond",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/python.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env scripts/python.mjs start",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test web/src/lib/*.test.ts scripts/*.test.mjs sandbox/tests/*.test.mjs",
    "test:python": "node scripts/python.mjs test",
    "lint:python": "node scripts/python.mjs lint",
    "package:validate": "node scripts/python.mjs package validate",
    "schema:executable": "uv run --frozen --project sdk/python python -m lotuspond_sdk.executable.schema",
    "check:executable-contracts": "uv run --frozen --project sdk/python python -m lotuspond_sdk.executable.schema --check",
    "schema:contracts": "node scripts/python.mjs package-schema",
    "check:contracts": "node scripts/python.mjs package-schema --check",
    "worker": "node --env-file-if-exists=.env scripts/python.mjs worker",
    "worker:alerts": "node --env-file-if-exists=.env scripts/python.mjs alert-worker",
    "worker:mail": "node --env-file-if-exists=.env scripts/python.mjs mail-worker",
    "worker:execution": "node --env-file-if-exists=.env scripts/python.mjs execution-worker",
    "test:database": "node scripts/python.mjs test-database",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:init": "node --env-file-if-exists=.env scripts/python.mjs init",
    "db:migrate": "node --env-file-if-exists=.env scripts/python.mjs migrate",
    "offline-identity": "node --env-file-if-exists=.env scripts/python.mjs offline-identity",
    "retention": "node --env-file-if-exists=.env scripts/python.mjs retention",
    "check": "npm run lint && npm test && npm run lint:python && npm run test:python && npm run check:sdk && npm run check:runtime && npm run check:contracts && npm run check:executable-contracts && npm run build",
    "cli": "node scripts/cli.mjs",
    "runner": "node scripts/runner.mjs",
    "voice": "node --env-file-if-exists=.env voice-bridge/src/cli.mjs",
    "test:voice": "npm --prefix voice-bridge run check",
    "test:protocol": "npm --prefix protocol-adapters run check",
    "format": "prettier --write . --ignore-unknown",
    "check:runtime": "uv sync --frozen --project runtime/python && uv run --frozen --project runtime/python ruff check runtime/python && uv run --frozen --project runtime/python pytest runtime/python/tests -q",
    "check:sdk": "uv sync --frozen --project sdk/python && uv run --frozen --project sdk/python ruff check sdk/python && uv run --frozen --project sdk/python pytest sdk/python/tests -q"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
