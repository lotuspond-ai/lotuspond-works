# The default development database is created by npm run db:start.
LOTUSPOND_DATABASE_URL=postgresql+psycopg://lotuspond@127.0.0.1:55439/lotuspond_platform_dev
LOTUSPOND_ENV=development
# Enable only for local onboarding; hosted deployments default to closed signup.
LOTUSPOND_REGISTRATION_ENABLED=true
LOTUSPOND_ORIGIN=http://127.0.0.1:8000
# Use http://127.0.0.1:3001 as the origin while using npm run dev:web.
# Optional local authenticator testing; use a private, stable 32-byte base64 key.
# Production platform operators must enroll MFA with this key configured.
# LOTUSPOND_MFA_ENCRYPTION_KEY=
# Verification, invitations, and recovery mail are disabled until configured.
LOTUSPOND_MAIL_ENABLED=false
# Resolve a URL-safe base64 32-byte encryption key from your secret store.
# LOTUSPOND_MAIL_ENCRYPTION_KEY=
# LOTUSPOND_SMTP_HOST=127.0.0.1
# LOTUSPOND_SMTP_PORT=1025
# LOTUSPOND_SMTP_FROM=identity@lotuspond.example.com
# Disable TLS only for an independently verified loopback development receiver.
# LOTUSPOND_SMTP_STARTTLS=false
# LOTUSPOND_SMTP_USERNAME=
# LOTUSPOND_SMTP_PASSWORD=
# LOTUSPOND_SMTP_TIMEOUT_SECONDS=15
# Bound for the whole SMTP conversation, not only one socket operation.
# LOTUSPOND_SMTP_CONVERSATION_SECONDS=45
# Run npm run worker:mail after configuring an authorized mail server.
# Production requires a shared, authenticated Redis rate-limit store.
# LOTUSPOND_REDIS_URL=redis://localhost:6379/0
