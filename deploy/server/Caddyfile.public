# HTTPS for the public LotusPond Works production server behind the Cloudflare proxy. The same as
# Caddyfile.origin without its X-Robots-Tag header and robots.txt, so search engines may list the site.
# Chosen with CADDYFILE=Caddyfile.public in deploy/server/.env.
#
# Caddy serves a Cloudflare Origin CA certificate from deploy/server/origin/ (cert.pem, key.pem, never
# committed). Set SSL/TLS to Full (strict) for the hostname, and let only Cloudflare reach ports 80 and 443.
{
	auto_https disable_certs
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
	encode zstd gzip
	header -Server
	reverse_proxy api:8000 {
		# The visitor's address as Cloudflare saw it, so sign-in rate limits apply per visitor.
		header_up X-Forwarded-For {client_ip}
	}
}
