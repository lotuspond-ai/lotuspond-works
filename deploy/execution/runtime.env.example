# Copy outside the extracted archive, replace every placeholder, and chmod 600.
# LOTUSPOND_API_URL may be an origin or the API base ending in /api/v1.
LOTUSPOND_API_URL=https://lotuspond.example.com/api/v1
LOTUSPOND_API_KEY=
LOTUSPOND_RUNNER_ID=
LOTUSPOND_NETWORK_MODE=connected

# HTTP adapter. Leave the token empty when the agent does not require one.
LOTUSPOND_HTTP_ENDPOINT=https://agent.example.com/v1
LOTUSPOND_HTTP_MODE=plain-input
LOTUSPOND_HTTP_TOKEN=

# MCP adapter. The tool name is operator configuration, never scenario input.
LOTUSPOND_MCP_ENDPOINT=https://mcp.example.com/mcp
LOTUSPOND_MCP_TOOL=
LOTUSPOND_MCP_TOKEN=

# runner-a2a: an operator-configured A2A agent endpoint (JSON-RPC message/send).
# Remote endpoints must use HTTPS; only a completed task is judged.
# LOTUSPOND_A2A_ENDPOINT=https://agent.example.com/a2a
# LOTUSPOND_A2A_TOKEN=
