# Durable execution worker (orchestrator or sweeper), run from the API image. A worker
# serves no HTTP, so turn off the image's API healthcheck:
#   docker run --no-healthcheck --env-file execution-worker.env lotuspond-api:<version> execution-worker --role orchestrator
#   docker run --no-healthcheck --env-file execution-worker.env lotuspond-api:<version> execution-worker --role sweeper
# Copy outside the repository, replace every placeholder, and chmod 600. Give each
# worker process its own file, or at least its own LOTUSPOND_EXECUTION_WORKER_WORKER_ID.
#
# This release ships no qualified production engine providers: with this file
# complete, a worker still refuses to start (exit 2, "engine_unavailable"). That is
# the intended state until a qualified integration is configured; see
# docs/operations/durable-execution.md.

# The worker's own least-privilege PostgreSQL role, never the migration owner. Only
# libpq TLS and timeout parameters may be added to the query string.
LOTUSPOND_EXECUTION_WORKER_DATABASE_URL=postgresql+psycopg://lotuspond_orchestrator:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/lotuspond?sslmode=verify-full

# Unique per process, at most 40 characters: it names the PostgreSQL session
# (application_name lotuspond-<role>:<worker id>) for observation and cleanup.
LOTUSPOND_EXECUTION_WORKER_WORKER_ID=REPLACE_WITH_UNIQUE_WORKER_ID

# Interpreter versions this worker serves, as a JSON array. A worker refuses to start
# while a non-terminal execution pins a version this build lacks.
LOTUSPOND_EXECUTION_WORKER_INTERPRETER_IDS=["lotuspond.execution-interpreter.v1"]

# Executions claimed (orchestrator) or items swept (sweeper) per cycle, 1-100.
LOTUSPOND_EXECUTION_WORKER_BATCH_LIMIT=25
# Idle polling backs off from the minimum to the maximum, 50-2000 ms.
LOTUSPOND_EXECUTION_WORKER_POLL_MIN_MS=200
LOTUSPOND_EXECUTION_WORKER_POLL_MAX_MS=2000

# Set on every worker connection and verified at startup, 100-15000 ms. PostgreSQL
# ends and rolls back a stalled worker's transaction, so another worker can continue.
LOTUSPOND_EXECUTION_WORKER_STATEMENT_TIMEOUT_MS=15000
LOTUSPOND_EXECUTION_WORKER_LOCK_TIMEOUT_MS=15000
LOTUSPOND_EXECUTION_WORKER_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# After SIGTERM or SIGINT, the process exits (code 3) if it has not stopped within
# this many seconds: more than 0, at most 60.
LOTUSPOND_EXECUTION_WORKER_SHUTDOWN_SECONDS=20
