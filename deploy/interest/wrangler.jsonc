{
  "name": "lotuspond-main",
  "account_id": "a9415202683c1d7629eef5f39330aa75",
  "main": "worker.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "INTEREST", "id": "ef17443628cc41b7932aa2fa4948ba13" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@lotuspond.ai"] }],
  "durable_objects": {
    "bindings": [{ "name": "CONFIRMATIONS", "class_name": "ConfirmationEmail" }],
  },
  "migrations": [{ "tag": "confirmation-v1", "new_sqlite_classes": ["ConfirmationEmail"] }],
  "routes": [
    { "pattern": "lotuspond.ai", "custom_domain": true },
    { "pattern": "www.lotuspond.ai", "custom_domain": true },
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_LIMIT",
      "namespace_id": "2026110601",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
