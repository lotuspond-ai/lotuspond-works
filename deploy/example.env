# Copy outside the repository, replace every placeholder, and chmod 600.
LOTUSPOND_API_IMAGE=lotuspond-api:0.2.0
POSTGRES_IMAGE=postgres:18.6-alpine3.24
REDIS_IMAGE=redis:7.2.16-alpine3.21

POSTGRES_DB=lotuspond
POSTGRES_USER=lotuspond
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD

LOTUSPOND_DATABASE_URL=postgresql+psycopg://lotuspond:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/lotuspond
LOTUSPOND_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
LOTUSPOND_ORIGIN=https://lotuspond.example.com
LOTUSPOND_REGISTRATION_ENABLED=false

# Required for authenticator enrollment and production platform operators.
# Use a distinct, stable URL-safe base64 32-byte key from your secret store.
# Back it up separately from the database. Never rotate it by replacing it here.
LOTUSPOND_MFA_ENCRYPTION_KEY=
# Require an authenticator in every workspace. A configured MFA key is mandatory.
# Production platform operators require MFA independently of this setting.
LOTUSPOND_REQUIRE_MFA=false

# Optional identity mail: configure secrets and start the Compose mail profile.
# Accepted requests do not prove delivery.
LOTUSPOND_MAIL_ENABLED=false
LOTUSPOND_MAIL_ENCRYPTION_KEY=
LOTUSPOND_SMTP_HOST=
LOTUSPOND_SMTP_PORT=587
LOTUSPOND_SMTP_USERNAME=
LOTUSPOND_SMTP_PASSWORD=
LOTUSPOND_SMTP_FROM=
LOTUSPOND_SMTP_STARTTLS=true
LOTUSPOND_SMTP_TIMEOUT_SECONDS=15
# Whole SMTP conversation bound; must be at least the socket timeout, at most 120.
LOTUSPOND_SMTP_CONVERSATION_SECONDS=45

LOTUSPOND_BIND_ADDRESS=127.0.0.1
LOTUSPOND_PORT=8000
