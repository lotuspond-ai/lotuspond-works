# Copy outside the repository, replace every placeholder, and chmod 600.
LOTUSPOND_API_IMAGE=lotuspond-api:0.2.0
LOTUSPOND_COLLECTOR_IMAGE=lotuspond-collector:0.2.0
POSTGRES_IMAGE=postgres:18.6-alpine3.24
REDIS_IMAGE=redis:7.2.16-alpine3.21

POSTGRES_DB=lotuspond
POSTGRES_USER=lotuspond
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD

LOTUSPOND_DATABASE_URL=postgresql+psycopg://lotuspond:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/lotuspond
LOTUSPOND_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
LOTUSPOND_ORIGIN=https://lotuspond.example.com
LOTUSPOND_NETWORK_MODE=connected
LOTUSPOND_REGISTRATION_ENABLED=false

# Required for authenticator enrollment and production platform operators.
# Use a distinct, stable URL-safe base64 32-byte key from your secret store.
# Back it up separately from the database. Never rotate it by replacing it here.
LOTUSPOND_MFA_ENCRYPTION_KEY=

# Optional identity mail: configure secrets and start the Compose mail profile.
# Mail is unavailable in airgap mode. Accepted requests do not prove delivery.
LOTUSPOND_MAIL_ENABLED=false
LOTUSPOND_MAIL_ENCRYPTION_KEY=
LOTUSPOND_SMTP_HOST=
LOTUSPOND_SMTP_PORT=587
LOTUSPOND_SMTP_USERNAME=
LOTUSPOND_SMTP_PASSWORD=
LOTUSPOND_SMTP_FROM=
LOTUSPOND_SMTP_STARTTLS=true
LOTUSPOND_SMTP_TIMEOUT_SECONDS=15

# Optional semantic evaluation. Leave both URL and key empty to record unknown
# semantic outcomes without outbound evaluation calls.
LOTUSPOND_TYPESAFE_BASE_URL=
LOTUSPOND_TYPESAFE_API_KEY=
LOTUSPOND_TYPESAFE_MODEL=jev-latest
LOTUSPOND_TYPESAFE_TIMEOUT_SECONDS=20

# Optional OpenAI-compatible model gateway. JSON is parsed by Pydantic.
LOTUSPOND_PROVIDER_URL=
LOTUSPOND_PROVIDER_KEY=
LOTUSPOND_PROVIDER_MODELS=[]
LOTUSPOND_PROVIDER_TIMEOUT_SECONDS=20
LOTUSPOND_PROVIDER_RESPONSE_BYTES=2097152

COLLECTOR_INGEST_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
# Optional authenticated /metrics; use a separate random token of at least 32 characters.
# Empty leaves the metrics route disabled. Never reuse an ingestion or API key.
COLLECTOR_METRICS_TOKEN=
LOTUSPOND_API_KEY=REPLACE_WITH_TELEMETRY_INGEST_SCOPED_KEY
LOTUSPOND_PROJECT_ID=REPLACE_WITH_MONITORED_PROJECT_UUID
LOTUSPOND_BIND_ADDRESS=127.0.0.1
LOTUSPOND_PORT=8000
COLLECTOR_BIND_ADDRESS=127.0.0.1
COLLECTOR_PORT=4318
# Optional durable spool. /spool keeps accepted batches on the collector-spool volume
# while the API is unreachable and replays them after restarts; empty keeps the collector
# stateless. A full spool answers 503 so exporters keep their batches.
COLLECTOR_SPOOL_DIR=
COLLECTOR_SPOOL_MAX_BYTES=268435456

# Optional signed incident alerts. Operator-managed destinations receive metadata
# for every workspace. Resolve signing secrets from your secret store.
# Keep empty in airgap mode; run the alerts worker only after configuration.
LOTUSPOND_ALERT_WEBHOOKS=[]
LOTUSPOND_ALERT_TIMEOUT_SECONDS=10
